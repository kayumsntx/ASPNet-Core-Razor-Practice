@page
@model MyFirstRazorProject.Pages.Students.IndexModel
@{
    <h1>Student List</h1>
    <p>
    <a class="btn btn-success" asp-asp-page="./Create">Add New Student</a>
    </p>

    <table class="table table-bordered table-striped">
    <thead>
    <tr>
                <th>Image</th>
                <th>Student Name</th>
                <th>Mobile No</th>
                <th>Course Name</th>
                <th>Addmission Date</th>
                <th>Enrolled?</th>
                <th>Modules</th>
                <th>Actions</th>
    </tr>
    </thead>
    <tbody id="student-list-body">
            @if (Model.Students.Any())
            {
                @foreach (var item in Model.Students)
                {
                    <tr data-student-itemid="@item.StudentId">
                    <td>.
                    <img src="~/images/@item.ImageUrl" width="100" height="100" class="rounded"/>
                    </td>
                        <td>@item.StudentName</td>
                        <td>@item.MobileNo</td>
                        <td>@item.Course.CourseName</td>
                        <td>@item.AdmissionDate.ToShortDateString()</td>
                        <td>@(item.IsEnrolled ? "Enrolled" : "Not Enrolled")</td>
                        <td>
                            <ul>
                                @foreach (var m in item.CourseModules)
                                {
                                  
                                        <li>@m.ModuleName - @m.Duration</li>
                                   
                                }
                            </ul>
                            
                        </td>
                        <td>
                        <a href="Student/Edit?id=@item.StudentId" class="btn btn-primary">Edit</a>
                      
                        <form method="post" asp-page="./Index" asp-page-handler="Delete">

                        <input type="hidden" asp-for="@item.StudentId" name="id" />
                        <button type="submit" class="btn btn-danger btn-sm" > Delete</button>
                        
                        </form>
                        </td>
                    </tr>
                }

                
            }
        </tbody>
    </table>
}
