@page
@model MyFirstRazorProject.Pages.Students.CreateModel
@{

    <h1>Update Student</h1>
    <hr />
    <div class="col-md-12">
        <form id="editForm" method="post" enctype="multipart/form-data">

            <div class="row">

                <div class="col-md-7">
                    <div asp-validation-summary="ModelOnly" class="text-danger">
                    </div>
                    <h4>Student Info</h4>
                    <div class="form-group">
                        <label asp-for="StudentViewModel.StudentName" class="control-label"></label>
                        <input asp-for="StudentViewModel.StudentName" class="form-control" />
                        <span asp-validation-for="StudentViewModel.StudentName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="StudentViewModel.AdmissionDate" class="control-label"></label>
                        <input asp-for="StudentViewModel.AdmissionDate" class="form-control" />
                        <span asp-validation-for="StudentViewModel.AdmissionDate" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="StudentViewModel.MobileNo" class="control-label"></label>
                        <input asp-for="StudentViewModel.MobileNo" class="form-control" />
                        <span asp-validation-for="StudentViewModel.MobileNo" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="StudentViewModel.CourseId" class="control-label"></label>
                        <select class="form-control" asp-for="StudentViewModel.CourseId"
                                asp-items="@(new SelectList(Model.StudentViewModel.Courses, "CourseId", "CourseName"))">
                            <option value="0">Select Course</option>
                        </select>
                        <span asp-validation-for="StudentViewModel.CourseId" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="StudentViewModel.CourseFee" class="control-label"></label>
                        <input asp-for="StudentViewModel.CourseFee" class="form-control" />
                        <span asp-validation-for="StudentViewModel.CourseFee" class="text-danger"></span>
                    </div>
                    <div class="form-group form-check mt-2">
                        <label class="form-check-label">
                            <input class="form-check-input" asp-for="StudentViewModel.IsEnrolled" />
                            @Html.DisplayNameFor(model => model.StudentViewModel.IsEnrolled)
                        </label>
                    </div>
                    <div class="form-group">
                        <div class="row align-items-center">
                            <div class="col-sm-4">
                                <img id="imgPreview" src="~/images/@(Model.OldImageUrl ?? "noimage.png")" class="img-thumbnail" style="width:90px; height:90px" />
                                <label for="img" class="form-label fw-bold">Upload Picture</label>
                            </div>
                            <div class="col-sm-8">
                                <input style="display: none;" id="img" name="ProfileFile" type="file" class="form-control" accept="image/*" onchange="showImagePreview(this)" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group mt-3">
                        <input type="submit" value="Create" class="btn btn-primary" />

                    </div>
                </div>
                <div class="col-md-5">
                    <h4>Course Module</h4>
                    <button type="button" class="btn btn-success mb-2" onclick="AddModule()">Add Module</button>

                    <table class="table" id="moduletable">
                        <thead>
                            <tr>
                                <th>Module Name</th>
                                <th>Duration</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.StudentViewModel.CourseModules != null)
                            {

                                @for (var i = 0; i < Model.StudentViewModel.CourseModules.Count; i++)
                                {
                                    <tr>
                                        <td><input type="text" class="form-control" asp-for="StudentViewModel.CourseModules[i].ModuleName" /></td>

                                        <td> <input type="text" class="form-control" asp-for="StudentViewModel.CourseModules[i].Duration" /></td>
                                        <td><button type="button" onclick="DeleteItem(this)" class="btn btn-danger btn-sm"></button></td>

                                    </tr>

                                }

                            }
                        </tbody>
                    </table>
                    <input type="hidden" id="hdnLastIndex" value="@(Model.StudentViewModel.CourseModules?.Count ?? 0)" />

                </div>

            </div>
        </form>
    </div>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>


<script>
          function showImagePreview(input) {
            if (input.files && input.files[0]) {
                var rdr = new FileReader();
                rdr.onload = function (e) {
                    $("#imgPreview").attr("src", e.target.result);
                }
                rdr.readAsDataURL(input.files[0]);
            }
        }

    function AddModule(){
        var lastIndex =parseInt($('#hdnLastIndex') .val());
        var newRow
        var htmlRow=`<tr>
            <td>
                <input type="hidden" name="StudentViewModel.CourseModules[${lastIndex}].CourseModuleId" value="0" />
                <input name="StudentViewModel.CourseModules[${lastIndex}].ModuleName" class="form-control" />
            </td>
            <td>
                <input name="StudentViewModel.CourseModules[${lastIndex}].Duration" class="form-control" />
            </td>

             <td><button type="button" onclick="DeleteItem(this)" class="btn btn-danger btn-sm">Remove</button>
             </td>
        </tr>`;
        $('#moduletable tbody').append(htmlRow)
         $('#hdnLastIndex').val(lastIndex+1);
    }
    function DeleteItem(btn){
        $(btn).closest('tr').remove();
        function reIndexTableRows() {
            $("#modulesTable tbody tr").each(function (rowIndex, trElement) {
                $(trElement).find("input").each(function () {
                    var currentName = $(this).attr("name");
                    if (currentName) {
                        var calculateName = currentName.replace(/\[\d+\]/, '[' + rowIndex + ']');
                        $(this).attr("name", calculateName);
                    }
                });
            });
        }
    });
    


</script>




